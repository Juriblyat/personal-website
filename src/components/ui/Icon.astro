---
import { type IconName, icons } from './icons';

interface Props {
  name: IconName;
  /** CSS size; defaults to the surrounding text size. */
  size?: string;
  /** Accessible name. Omit for decorative icons (they are hidden from assistive tech). */
  label?: string;
}
const { name, size = '1.25em', label } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {icons[name].map((d) => <path d={d} />)}
</svg>
