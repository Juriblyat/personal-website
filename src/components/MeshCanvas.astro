---
// The one persistent canvas behind every page. `transition:persist` keeps the same element (and its
// WebGL context) alive across view transitions, so the Mesh never reloads or flashes.
// The 3D code is a separate chunk, fetched only after the page has loaded and the browser is idle,
// so it can never delay content (LCP). With JS off, WebGL off or reduced motion the canvas stays empty.
---

<canvas id="mesh" class="mesh" aria-hidden="true" data-mesh="off" transition:persist></canvas>

<script>
  import { isSoftwareRenderer } from '../lib/gpu';

  const canvas = document.getElementById('mesh') as HTMLCanvasElement | null;

  // Why the Mesh is not running, or null if it should. `?tier=high|mid` forces it on and `?tier=low`
  // forces it off (for testing; P4.2 expands this into the full capability tiers).
  function skipReason(): string | null {
    const tier = new URLSearchParams(location.search).get('tier');
    if (tier === 'low') return 'tier-low';
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return 'reduced-motion';
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    if (connection?.saveData) return 'save-data';
    if (tier) return null;
    const gl = document.createElement('canvas').getContext('webgl2');
    const info = gl?.getExtension('WEBGL_debug_renderer_info');
    const renderer = gl && info ? String(gl.getParameter(info.UNMASKED_RENDERER_WEBGL)) : '';
    gl?.getExtension('WEBGL_lose_context')?.loseContext();
    return isSoftwareRenderer(renderer) ? 'software-renderer' : null;
  }

  const start = () => {
    if (!canvas) return;
    const reason = skipReason();
    if (reason) {
      canvas.dataset.meshReason = reason;
      return;
    }
    canvas.dataset.mesh = 'loading';
    import('../scene/host')
      .then((m) => m.startMesh(canvas))
      .catch(() => {
        canvas.dataset.mesh = 'unsupported';
      });
  };

  // After the page has loaded and the browser is idle, so the Mesh can never delay content.
  const whenIdle = () =>
    'requestIdleCallback' in window
      ? requestIdleCallback(start, { timeout: 3000 })
      : setTimeout(start, 1000);
  if (document.readyState === 'complete') whenIdle();
  else addEventListener('load', whenIdle, { once: true });
</script>

<style>
  @layer components {
    .mesh {
      position: fixed;
      inset: 0;
      z-index: var(--z-canvas);
      width: 100%;
      height: 100%;
      pointer-events: none;
      opacity: 0;
      transition: opacity var(--dur-slow) var(--ease-out);
    }
    .mesh[data-mesh='running'] {
      opacity: 1;
    }
  }
</style>
