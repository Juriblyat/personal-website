---
import Icon from '../ui/Icon.astro';
---

<!-- Hidden without JS (see <noscript> in Base): the theme then simply follows the OS. -->
<button type="button" class="toggle" data-theme-toggle aria-label="Switch theme">
  <span class="sun"><Icon name="sun" /></span>
  <span class="moon"><Icon name="moon" /></span>
</button>

<script>
  // Delegated, so it keeps working after view transitions swap the page.
  const effective = () =>
    document.documentElement.dataset.theme ??
    (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');

  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('[data-theme-toggle]')) return;
    const next = effective() === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  @layer components {
    .toggle {
      display: inline-grid;
      place-items: center;
      width: 2.25rem;
      height: 2.25rem;
      padding: 0;
      border: 1px solid var(--color-line-strong);
      border-radius: var(--radius-pill);
      background: transparent;
      color: inherit;
      cursor: pointer;
    }
    .toggle > span {
      grid-area: 1 / 1;
      line-height: 0;
    }
    /* Show the icon for the theme you would switch TO: no JS needed to track state. */
    .sun {
      color: light-dark(transparent, var(--color-text));
    }
    .moon {
      color: light-dark(var(--color-text), transparent);
    }
  }
</style>
