---
import Cluster from '../components/layout/Cluster.astro';
import Container from '../components/layout/Container.astro';
import Grid from '../components/layout/Grid.astro';
import Section from '../components/layout/Section.astro';
import Stack from '../components/layout/Stack.astro';
---

<h1>Layout</h1>
<p>Primitives: Container, Stack, Cluster, Grid, Section. Outlines show each box. Resize to 360, 768 and 1440.</p>

<h2>Container</h2>
<Stack gap={3}>
  {
    (['narrow', 'default', 'wide'] as const).map((size) => (
      <Container size={size}>
        <div class="box"><code>size="{size}"</code> (content width tokens, gutters at the sides)</div>
      </Container>
    ))
  }
</Stack>

<h2>Stack</h2>
<Stack gap={5}>
  <div class="box">gap 5</div>
  <div class="box">children separated by the gap</div>
  <div class="box">never by their own margins</div>
</Stack>

<h2>Cluster</h2>
<Cluster gap={2}>
  {['astro', 'svelte', 'three.js', 'typescript', 'hono', 'cloudflare', 'd1', 'durable objects', 'wasm'].map(
    (t) => <span class="tag">{t}</span>
  )}
</Cluster>

<h2>Grid</h2>
<p>Columns appear as space allows (<code>min="14rem"</code>); no breakpoints.</p>
<Grid min="14rem">
  {[1, 2, 3, 4, 5, 6].map((n) => <div class="box tall">card {n}</div>)}
</Grid>

<h2>Section rhythm</h2>
<div class="outlined">
  <Section><div class="box">Section A (padding-block: --section-space)</div></Section>
  <Section><div class="box">Section B</div></Section>
</div>

<style>
  .box {
    padding: var(--space-4);
    border: 1px dashed var(--color-line-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .tall {
    min-height: 6rem;
  }
  .tag {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent-2);
  }
  .outlined {
    border: 1px solid var(--color-line);
  }
</style>
