{
  "name": "personal-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "budget": "node scripts/check-bundle-size.mjs",
    "lighthouse": "lhci autorun && lhci autorun --config=lighthouserc.3d.json",
    "verify": "pnpm check && pnpm lint && pnpm test && pnpm build && pnpm budget",
    "test:e2e": "playwright test",
    "baselines": "node scripts/update-baselines.mjs"
  },
  "dependencies": {
    "@astrojs/svelte": "^9.1.0",
    "astro": "^7.4.1",
    "svelte": "^5.57.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@biomejs/biome": "^2.5.15",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@types/three": "^0.186.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.2"
  },
  "packageManager": "pnpm@12.14.0"
}
